{
    "name": "x-security-operation",
    "version": "2.0.0",
    "description": "x-security-operation",
    "repository": {
        "type": "git",
        "url": ""
    },
    "engines": {
        "npm": ">=5",
        "node": ">=8"
    },
    "author": "X",
    "license": "Apache-2.0",
    "scripts": {
        "analyze:clean": "rimraf stats.json",
        "preanalyze": "npm run analyze:clean",
        "analyze": "node ./internals/scripts/analyze.js",
        "npmcheckversion": "node ./internals/scripts/npmcheckversion.js",
        "preinstall": "npm run npmcheckversion",
        "prebuild": "npm run build:clean",
        "build": "cross-env NODE_ENV=production webpack --config internals/webpack/webpack.prod.babel.js --color -p --progress --hide-modules --display-optimization-bailout",
        "build:ci": "cross-env NODE_ENV=production webpack --config internals/webpack/webpack.prod.babel.js --color -p --progress --hide-modules --display-optimization-bailout",
        "prebuild:release": "npm run build:clean",
        "build:release": "cross-env NODE_ENV=production webpack --config internals/webpack/webpack.release.babel.js --color -p --hide-modules --display-optimization-bailout",
        "prebuild:develop": "npm run build:clean",
        "build:develop": "cross-env NODE_ENV=production webpack --config internals/webpack/webpack.develop.babel.js --color -p --hide-modules --display-optimization-bailout",
        "build:clean": "rimraf ./build",
        "start": "cross-env NODE_ENV=development node server",
        "start:tunnel": "cross-env NODE_ENV=development ENABLE_TUNNEL=true node server",
        "start:production": "npm run test && npm run build && npm run start:prod",
        "start:prod": "cross-env NODE_ENV=production node server",
        "presetup": "npm i chalk shelljs",
        "lint": "npm run lint:js",
        "lint:eslint": "eslint --ignore-path .gitignore",
        "lint:eslint:fix": "eslint --ignore-path .gitignore --fix",
        "lint:js": "npm run lint:eslint",
        "lint:staged": "lint-staged",
        "pretest": "npm run test:clean && npm run lint",
        "test:clean": "rimraf ./coverage",
        "test": "cross-env NODE_ENV=test jest --coverage",
        "test:ci": "cross-env NODE_ENV=test jest --coverage --ci --passWithNoTests --reporters=default --reporters=jest-junit",
        "test:watch": "cross-env NODE_ENV=test jest --watchAll",
        "prettify": "prettier --write",
        "start-electron": "electron .",
        "electron-builder": "electron-builder"
    },
    "repository": "https://github.com/electron/electron-quick-start",
    "build": {
        "productName":"com.x-security-operation.app",
        "appId": "x-security-operation",
        "asar": false,
        "files": [
            "build/*",
            "package.json",
            "main.js"
          ],
        "win": {
            "target": [
              {
                "target": "nsis",
                "arch": [
                  "ia32"
                ]
              }
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": true,
            "allowElevation": true,
            "allowToChangeInstallationDirectory": true
        }
    },
    "browserslist": [
        "last 2 versions",
        "> 1%",
        "IE 10"
    ],
    "pre-commit": "lint:staged",
    "lint-staged": {
        "*.js": [
            "npm run lint:eslint"
        ]
    },
    "dependencies": {
        "@ant-design/icons": "4.2.2",
        "@antv/data-set": "0.11.5",
        "@babel/polyfill": "7.11.5",
        "@ckeditor/ckeditor5-build-classic": "22.0.0",
        "antd": "4.6.4",
        "bin-wrapper": "npm:bin-wrapper-china",
        "bin-wrapper-china": "npm:bin-wrapper-china",
        "bizcharts": "4.0.14",
        "chalk": "4.1.0",
        "clsx": "1.1.1",
        "compression": "1.7.4",
        "connected-react-router": "6.8.0",
        "crypto-js": "4.0.0",
        "express": "4.17.1",
        "history": "4.10.1",
        "html2canvas": "1.0.0-rc.7",
        "immer": "7.0.9",
        "ip": "1.1.5",
        "iscroll": "5.2.0",
        "js-base64": "3.5.2",
        "js-md5": "0.7.3",
        "jsonwebtoken": "8.5.1",
        "jspdf": "2.1.1",
        "keycloak-js": "^11.0.2",
        "lodash": "4.17.20",
        "minimist": "1.2.5",
        "moment": "2.28.0",
        "nprogress": "0.2.0",
        "prop-types": "15.7.2",
        "query-string": "6.13.2",
        "react": "16.13.1",
        "react-dom": "16.13.1",
        "react-helmet": "6.1.0",
        "react-redux": "7.2.1",
        "react-router-dom": "5.2.0",
        "redux": "4.0.5",
        "redux-thunk": "2.3.0",
        "reselect": "4.0.0",
        "styled-components": "5.2.0",
        "webpack-node-externals": "^2.5.2",
        "xlsx": "0.16.7"
    },
    "devDependencies": {
        "@babel/cli": "7.11.6",
        "@babel/core": "7.11.6",
        "@babel/helper-validator-identifier": "7.10.4",
        "@babel/plugin-syntax-dynamic-import": "7.8.3",
        "@babel/plugin-transform-modules-commonjs": "7.10.4",
        "@babel/plugin-transform-react-constant-elements": "7.10.4",
        "@babel/plugin-transform-react-inline-elements": "7.10.4",
        "@babel/plugin-transform-typescript": "7.11.0",
        "@babel/preset-env": "7.11.5",
        "@babel/preset-react": "7.10.4",
        "@babel/preset-typescript": "7.10.4",
        "@babel/register": "7.11.5",
        "add-asset-html-webpack-plugin": "3.1.3",
        "babel-core": "7.0.0-bridge.0",
        "babel-eslint": "10.1.0",
        "babel-jest": "26.3.0",
        "babel-loader": "8.1.0",
        "babel-plugin-dynamic-import-node": "2.3.3",
        "babel-plugin-import": "1.13.0",
        "babel-plugin-lodash": "3.3.4",
        "babel-plugin-transform-react-remove-prop-types": "0.4.24",
        "circular-dependency-plugin": "5.2.0",
        "compare-versions": "3.6.0",
        "compression-webpack-plugin": "6.0.0",
        "cross-env": "7.0.2",
        "css-loader": "4.3.0",
        "devtron": "^1.4.0",
        "electron": "^11.1.1",
        "electron-builder": "^22.9.1",
        "eslint": "7.9.0",
        "eslint-config-airbnb": "18.2.0",
        "eslint-config-airbnb-base": "14.2.0",
        "eslint-config-prettier": "6.11.0",
        "eslint-import-resolver-webpack": "0.12.2",
        "eslint-loader": "4.0.2",
        "eslint-plugin-import": "2.22.0",
        "eslint-plugin-jsx-a11y": "6.3.1",
        "eslint-plugin-prettier": "3.1.4",
        "eslint-plugin-react": "7.20.6",
        "eslint-plugin-react-hooks": "4.1.2",
        "file-loader": "6.1.0",
        "html-loader": "1.3.0",
        "html-webpack-plugin": "4.4.1",
        "http-proxy-middleware": "1.0.5",
        "imports-loader": "1.1.0",
        "jest-cli": "26.4.2",
        "lint-staged": "10.3.0",
        "moment-locales-webpack-plugin": "1.2.0",
        "offline-plugin": "5.0.7",
        "plop": "2.7.4",
        "pre-commit": "1.2.2",
        "prettier": "2.1.2",
        "react-app-polyfill": "1.0.6",
        "react-test-renderer": "16.13.1",
        "rimraf": "3.0.2",
        "shelljs": "0.8.4",
        "style-loader": "1.2.1",
        "svg-url-loader": "6.0.0",
        "terser-webpack-plugin": "4.2.1",
        "typescript": "4.0.2",
        "url-loader": "4.1.0",
        "webpack": "4.44.1",
        "webpack-cli": "3.3.12",
        "webpack-dev-middleware": "3.7.2",
        "webpack-hot-middleware": "2.25.0",
        "webpack-pwa-manifest": "4.2.0"
    },
    "resolutions": {
        "babel-core": "7.0.0-bridge.0",
        "bin-wrapper": "npm:bin-wrapper-china"
    },
    "main": "main.js"
}
